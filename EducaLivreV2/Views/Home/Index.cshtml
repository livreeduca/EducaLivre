                    </div>
                    <div class="selo-item" data-tooltip="Selo de Biblioteca Atualizada">
                        <img src="/Assets/Selos/educa/05.svg" alt="Selo de Biblioteca Atualizada">
                    </div>
                    <div class="selo-item" data-tooltip="Selo de Participação Estudantil">
                        <img src="/Assets/Selos/educa/04.svg" alt="Selo de Participação Estudantil">
                    </div>
                    <div class="selo-item" data-tooltip="Selo de Qualificação Docente">
                        <img src="/Assets/Selos/educa/07.svg" alt="Selo de Qualificação Docente">
                    </div>
                    <div class="selo-item" data-tooltip="Selo de Liderança Feminina">
                        <img src="/Assets/Selos/igual/06.svg" alt="Selo de Liderança Feminina">
