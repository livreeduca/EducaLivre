@model List<EducaLivreV2.Models.Usuario>

@{
    ViewData["Title"] = "Lista de Usuários";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">
        <i class="fa fa-plus"></i> Novo Usuário
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Email</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td>@usuario.Id</td>
                <td>@usuario.Nome</td>
                <td>@usuario.Email</td>
                <td>
                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@usuario.Id">
                        <i class="fa fa-edit"></i> Editar
                    </a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@usuario.Id">
                        <i class="fa fa-trash-o"></i> Remover
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>