@using EducaLivreV2.Services
@inject AuthService AuthService
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ..:: Educa Livre ::..</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/codexino.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
    <!-- NAVBAR PRIMEIRO -->
    <nav class="navbar navbar-expand-sm navbar-dark main-navbar">
        <div class="container">
            <!-- LOGO À ESQUERDA -->
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="/assets/Logo.svg" alt="EducaLivre" class="logo">
            </a>

            <!-- Botão toggle para mobile -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Conteúdo colapsável -->
            <div class="collapse navbar-collapse" id="navbarContent">
                <!-- Links à esquerda (ao lado da logo) -->
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Selo" asp-action="Index">Selos</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contato">Contato</a>     
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">Sobre Nós</a></li>
                </ul>

                <!-- Menu dinâmico à direita -->
                <ul class="navbar-nav ms-auto">
                    <!-- ms-auto empurra para direita -->
                    @if (AuthService.IsLoggedIn())
                    {
                        <!-- USUÁRIO LOGADO -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                👤 @AuthService.GetUserName()
                            </a>
                            <ul class="dropdown-menu">
                                <!-- MOSTRAR PAINEL ADMIN APENAS PARA ADMINS -->
                                @if (AuthService.IsAdmin())
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Home" asp-action="PainelAdmin">
                                            <i class="fa fa-cog"></i> Painel Admin
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                }
                                <li>
                                    <a class="dropdown-item" href="#">
                                        <i class="fa fa-user"></i> Meu Perfil
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Home" asp-action="Contato">
                                        <i class="fa fa-envelope"></i> Contato
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Auth" asp-action="Logout">
                                        <i class="fa fa-sign-out"></i> Sair
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <!-- USUÁRIO NÃO LOGADO - APENAS UM BOTÃO -->
                        <li class="nav-item">
                            <a class="nav-link btn btn-outline-light btn-sm mx-1"
                               asp-controller="Auth"
                               asp-action="Login">
                                <i class="fa fa-user"></i> Entrar / Cadastrar
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- HEADER COM BUSCA FUNCIONAL -->
    <header class="main-header">
        <div class="container">
            <div class="header-content">
                <div class="search-section">
                    <form method="get" asp-controller="Busca" asp-action="Index" class="search-container">
                        <input type="text"
                               name="q"  
                        placeholder="Encontre uma instituição..."
                        class="search-input"
                        value="@Context.Request.Query["q"]"
                        required>
                        <button type="submit" class="search-button">
                            <i class="fas fa-search search-icon"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - EducaLivreV2 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
