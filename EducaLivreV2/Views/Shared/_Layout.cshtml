    <script>
        // Mostrar/ocultar botão baseado no scroll
        window.addEventListener('scroll', function() {
            const codexinoBtn = document.getElementById('codexinoScrollTop');
            if (window.scrollY > 300) {
                codexinoBtn.classList.add('show');
            } else {
                codexinoBtn.classList.remove('show');
            }
        });

        // Scroll suave para o topo - VERIFICAR SE ESTÁ FUNCIONANDO
        document.getElementById('codexinoScrollTop').addEventListener('click', function() {
            console.log('✅ Codexino clicado!'); // Debug
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });

              // Animação dos olhos seguindo o mouse - VERSÃO CORRIGIDA
                function setupCodexinoEyes() {
            const codexino = document.getElementById('codexinoScrollTop');
            if (!codexino) return;

            const pupilaEsquerda = codexino.querySelector('#path12238');
            const pupilaDireita = codexino.querySelector('#path12238-6');

            if (!pupilaEsquerda || !pupilaDireita) return;

            console.log('✅ Movimento elíptico ativado!');

            // ✅ PARÂMETROS DOS TRILHOS ELÍPTICOS
            const ellipseParams = {
                // Trilho do olho esquerdo (elipse menor dentro do olho)
                left: {
                    radiusX: 15.8,   // Movimento horizontal máximo
                    radiusY: 14.8    // Movimento vertical máximo
                },
                // Trilho do olho direito (elipse menor dentro do olho)
                right: {
                    radiusX: 15.2,   // Movimento horizontal máximo
                    radiusY: 14.0    // Movimento vertical máximo
                }
            };

            document.addEventListener('mousemove', function(e) {
                const rect = codexino.getBoundingClientRect();
                const centerX = rect.left + rect.width / 2;
                const centerY = rect.top + rect.height / 2;

                // ✅ Vetor do mouse em relação ao centro do Codexino
                const deltaX = e.clientX - centerX;
                const deltaY = e.clientY - centerY;

                // ✅ Ângulo do mouse (em radianos)
                const angle = Math.atan2(deltaY, deltaX);

                // ✅ Distância do mouse (para intensidade)
                const distance = Math.sqrt(deltaX * deltaX + deltaY * deltaY);
                const maxDistance = 2000;

                if (distance > maxDistance) {
                    resetPupils();
                    return;
                }

                // ✅ Intensidade baseada na distância
                const intensity = Math.min(distance / maxDistance, 1);

                // ✅ POSIÇÃO NAS ELIPSES (trilhos)
                // Pupila esquerda segue trilho elíptico esquerdo
                const moveLeftX = Math.cos(angle) * ellipseParams.left.radiusX * intensity;
                const moveLeftY = Math.sin(angle) * ellipseParams.left.radiusY * intensity;

                // Pupila direita segue trilho elíptico direito
                const moveRightX = Math.cos(angle) * ellipseParams.right.radiusX * intensity;
                const moveRightY = Math.sin(angle) * ellipseParams.right.radiusY * intensity;

                // ✅ APLICA MOVIMENTO
                pupilaEsquerda.style.transform = `translate(${moveLeftX}px, ${moveLeftY}px)`;
                pupilaDireita.style.transform = `translate(${moveRightX}px, ${moveRightY}px)`;
            });

            function resetPupils() {
                pupilaEsquerda.style.transform = 'translate(0, 0)';
                pupilaDireita.style.transform = 'translate(0, 0)';
            }

            document.addEventListener('mouseleave', resetPupils);
        }

        document.addEventListener('DOMContentLoaded', setupCodexinoEyes);
    </script>
</body>
</html>