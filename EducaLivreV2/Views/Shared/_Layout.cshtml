<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ..:: Educa Livre ::..</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EducaLivreV2.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
        <!-- NAVBAR PRIMEIRO -->
        <nav class="navbar navbar-expand-sm navbar-dark main-navbar">
            <div class="container">
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- Links à esquerda -->
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacidade</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">Sobre Nós</a></li>
                    </ul>
                    <!-- Login/Cadastro à direita -->
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Login">Login</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Register">Cadastro</a></li>
                        <!--
                        <li><a class="nav-link text-dark" asp-controller="Usuario" asp-action="Index">Usuários</a></li>
                        -->
                    </ul>
                </div>
            </div>
        </nav>

        <!-- HEADER COM LOGO E BUSCA -->
        <header class="main-header">
            <div class="container">
                <div class="header-content">
                    <!-- LOGO -->
                    <div class="logo-section">
                        <a asp-controller="Home" asp-action="Index">
                            <img src="/assets/Logo.svg" alt="EducaLivre" class="logo">
                        </a>
                    </div>

                    <!-- CAMPO DE BUSCA CENTRALIZADO -->
                    <div class="search-section">
                        <div class="search-container">
                            <input type="text" placeholder="Encontre uma instituição..." class="search-input">
                        <button class="search-button">
                            <i class="fas fa-search search-icon"></i>
                        </button>
                        </div>
                    </div>

                    <!-- ESPAÇO VAZIO PARA ALINHAMENTO -->
                    <div class="placeholder-section"></div>
                </div>
            </div>
        </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - EducaLivreV2 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
