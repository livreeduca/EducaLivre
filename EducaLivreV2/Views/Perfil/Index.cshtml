@model EducaLivreV2.Models.Usuario

@{
    ViewData["Title"] = "Meu Perfil";
}

<div class="container mt-4">
    <!-- Mensagens -->
    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["MensagemSucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["MensagemErro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <!-- Avatar -->
                    <div class="avatar-perfil mb-3">
                        @Model.Nome[0]
                    </div>

                    <h4>@Model.Nome</h4>
                    <p class="text-muted">@Model.Email</p>

                    @if (Model.IsAdmin)
                    {
                        <span class="badge bg-danger mb-2">Administrador</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary mb-2">Usuário</span>
                    }

                    <hr>

                    <!-- Menu do Perfil -->
                    <div class="list-group list-group-flush">
                        <a href="@Url.Action("Editar", "Perfil")"
                           class="list-group-item list-group-item-action active">
                            <i class="fas fa-user-edit"></i> Editar Perfil
                        </a>
                        <a href="@Url.Action("Seguranca", "Perfil")"
                           class="list-group-item list-group-item-action">
                            <i class="fas fa-shield-alt"></i> Segurança
                        </a>
                        <a href="@Url.Action("Atividade", "Perfil")"
                           class="list-group-item list-group-item-action">
                            <i class="fas fa-history"></i> Minha Atividade
                        </a>
                        @if (Model.IsAdmin)
                        {
                            <a href="@Url.Action("PainelAdmin", "Home")"
                               class="list-group-item list-group-item-action">
                                <i class="fas fa-cogs"></i> Painel Admin
                            </a>
                        }
                        <a href="@Url.Action("Logout", "Auth")"
                           class="list-group-item list-group-item-action text-danger">
                            <i class="fas fa-sign-out-alt"></i> Sair
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Conteúdo Principal -->
        <div class="col-md-8">
            <!-- Estatísticas -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card stat-card">
                        <div class="card-body text-center">
                            <div class="stat-icon text-primary">
                                <i class="fas fa-star fa-2x"></i>
                            </div>
                            <h3 class="stat-number">0</h3>
                            <p class="stat-label">Avaliações</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card stat-card">
                        <div class="card-body text-center">
                            <div class="stat-icon text-success">
                                <i class="fas fa-comment fa-2x"></i>
                            </div>
                            <h3 class="stat-number">0</h3>
                            <p class="stat-label">Comentários</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card stat-card">
                        <div class="card-body text-center">
                            <div class="stat-icon text-warning">
                                <i class="fas fa-heart fa-2x"></i>
                            </div>
                            <h3 class="stat-number">0</h3>
                            <p class="stat-label">Favoritos</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Informações do Perfil -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Informações do Perfil</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Nome:</strong> @Model.Nome</p>
                            <p><strong>Email:</strong> @Model.Email</p>
                        </div>
                        <div class="col-md-6">
                            <p>
                                <strong>Tipo de Conta:</strong>
                                @if (Model.IsAdmin)
                                {
                                    <span class="badge bg-danger">Administrador</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Usuário Comum</span>
                                }
                            </p>
                            <p><strong>Membro desde:</strong> Em breve...</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Atividades Recentes -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-history"></i> Atividades Recentes</h5>
                </div>
                <div class="card-body">
                    <div class="text-center py-5">
                        <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                        <h5>Nenhuma atividade recente</h5>
                        <p class="text-muted">Suas avaliações e comentários aparecerão aqui.</p>
                        <a href="@Url.Action("Index", "Busca")" class="btn btn-success mt-2">
                            <i class="fas fa-search"></i> Buscar Escolas para Avaliar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-perfil {
        width: 120px;
        height: 120px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        color: white;
        font-weight: bold;
        box-shadow: 0 4px 15px rgba(106, 17, 203, 0.3);
    }

    .stat-card {
        border: none;
        border-radius: 10px;
        transition: transform 0.3s ease;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    .stat-icon {
        margin-bottom: 10px;
    }

    .stat-number {
        font-size: 2.5rem;
        font-weight: bold;
        color: #2c3e50;
        margin: 10px 0;
    }

    .stat-label {
        color: #7f8c8d;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.9rem;
    }

    .list-group-item.active {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-color: #667eea;
    }
</style>